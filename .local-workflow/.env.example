# 本地 CI 凭据。复制为 .env 后填写；.env 已被 .gitignore 忽略，勿提交。
#
#   cp .local-workflow/.env.example .local-workflow/.env
#
# 读取优先级：环境变量 > 本文件。留空的项脚本会自己推导。

# 阿里云 ACR 镜像仓库前缀（含命名空间）。留空则自动从 k8s/05-backend.yaml
# 现有的 image 行反推，所以一般不用改。
ACR_REGISTRY=crpi-2jeh8zb0taelsoax.cn-wulanchabu.personal.cr.aliyuncs.com/nullpointexception

# ACR 登录凭据（对应 GitHub 仓库 secrets 里的 ACR_USERNAME / ACR_PASSWORD）
ACR_USERNAME=
ACR_PASSWORD=

# GitHub 仓库，Release 与 tag push 都用它
GITHUB_REPO=nullpointexception-i/agent-sphere

# GitHub token：留空则读 local-config/token.json 的 github.token
GITHUB_TOKEN=
